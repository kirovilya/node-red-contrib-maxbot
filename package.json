{
  "name": "node-red-contrib-maxbot",
  "version": "0.7.0",
  "description": "Node-RED nodes for MAX messenger",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p . && shx mkdir -p dist/nodes && shx cp -r src/nodes/*.html dist/nodes/ && shx mkdir -p dist/certs && shx cp src/certs/*.pem dist/certs/",
    "watch": "tsc -w",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "node-red",
    "max",
    "messenger",
    "maxbot",
    "node-red-node"
  ],
  "author": "Kirov Ilya",
  "license": "MIT",
  "dependencies": {
    "@maxhub/max-bot-api": "^0.2.4",
    "@types/node-red": "^1.3.5",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^8.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.0.0"
  },
  "node-red": {
    "nodes": {
      "maxbot-config": "dist/nodes/maxbot-config.js",
      "maxbot-send": "dist/nodes/maxbot-send.js",
      "maxbot-receive": "dist/nodes/maxbot-receive.js"
    }
  }
}
